RUNCOACH_HOST=127.0.0.1

RUNCOACH_PORT=3100
RUNCOACH_DATA_DIR=.local-data
RUNCOACH_LOCAL_OFFSET_MINUTES=480
RUNCOACH_MAX_UPLOAD_BYTES=52428800

# AI 回顾（M6）：默认禁用。真实调用需同时设置 ENABLED=true、PROVIDER=deepseek
# 并填入你自己的 API key；key 只保存在本机 .env，绝不提交到 Git、写进前端或日志。
# 留空的 RUNCOACH_DEEPSEEK_API_KEY 视为未配置，不会阻止服务启动。
# 发送内容受字段白名单限制：仅数值聚合（跑量/时长/配速/完整周汇总/计划计数），
# 不发送原始导入、samples、GPS、每日状态量表或备注；但跑步数据本身可能被
# 视为健康相关信息，是否发送由你自己判断。调用 POST /api/ai/context 可在
# 发送前预览实际将发送的内容（预览绝不调用模型）。
# 注意：DeepSeek 条款允许在去标识化前提下将输入输出用于模型优化；服务端
# 启用开关只表示允许调用，每次发送仍需你主动触发接口，后续 UI 会提供
# “先预览再确认”的流程，本开关不等于你已完成发送前确认。
RUNCOACH_AI_ENABLED=false
RUNCOACH_AI_PROVIDER=none
RUNCOACH_DEEPSEEK_API_KEY=
RUNCOACH_DEEPSEEK_BASE_URL=https://api.deepseek.com
RUNCOACH_AI_TIMEOUT_MS=20000
RUNCOACH_AI_MAX_OUTPUT_TOKENS=512
